# Database
DATABASE_URL=

# Clerk auth (routing URL vars are read by Clerk directly, not validated in src/lib/env.ts)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Marketing metadata (optional in dev; set in production for Open Graph absolute URLs)
NEXT_PUBLIC_SITE_URL=

# Cron and alert caps (validated in src/lib/env.ts)
CRON_SECRET=
MAX_ALERTS_PER_USER_PER_RUN=10
MAX_TELEGRAM_MESSAGES_PER_MINUTE=20

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Market data providers
FRED_API_KEY=
TWELVE_DATA_API_KEY=
TWELVE_DATA_MAX_CALLS_PER_MINUTE=7

# Provider fetch behavior
PROVIDER_FETCH_MAX_RETRIES=3
PROVIDER_FETCH_TIMEOUT_MS=15000
